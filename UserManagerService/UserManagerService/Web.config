<?xml version="1.0"?>
<configuration>  

  <configSections>

    <section name="dataConfiguration" type="Microsoft.Practices.EnterpriseLibrary.Data.Configuration.DatabaseSettings, Microsoft.Practices.EnterpriseLibrary.Data, Version=5.0.414.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" requirePermission="true" />
    <section name="exceptionHandling" type="Microsoft.Practices.EnterpriseLibrary.ExceptionHandling.Configuration.ExceptionHandlingSettings, Microsoft.Practices.EnterpriseLibrary.ExceptionHandling, Version=5.0.414.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" requirePermission="true" />
    <section name="loggingConfiguration" type="Microsoft.Practices.EnterpriseLibrary.Logging.Configuration.LoggingSettings, Microsoft.Practices.EnterpriseLibrary.Logging, Version=5.0.414.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" requirePermission="true" />
    <sectionGroup name="system.web.extensions" type="System.Web.Configuration.SystemWebExtensionsSectionGroup, System.Web.Extensions, Version=3.5.0.0, Culture=neutral, PublicKeyToken=31BF3856AD364E35">
    </sectionGroup>
  </configSections>

  <dataConfiguration defaultDatabase="MembershipDB" />
  <connectionStrings>
    <add name="MembershipDB" connectionString="Database=Quivus.Membership;Server=000.000.0.00;User ID=0;Password=0;"
        providerName="System.Data.SqlClient" />
    <add name="PreferencesDB" connectionString="Database=Quivus.Preferences;Server=000.000.0.00;User ID=0;Password=0;"
       providerName="System.Data.SqlClient" />
    <add name="CommunicationDB" connectionString="Database=Quivus.Communication;Server=000.000.0.00;User ID=0;Password=0;"
       providerName="System.Data.SqlClient" />
  </connectionStrings>

  <exceptionHandling>
    <exceptionPolicies>
      <add name="UserManagerServicePolicy">
        <exceptionTypes>
          <add name="Exception" type="System.Exception, mscorlib, Version=2.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089"
            postHandlingAction="ThrowNewException">
            <exceptionHandlers>
              <add type="Microsoft.Practices.EnterpriseLibrary.ExceptionHandling.WCF.FaultContractExceptionHandler, Microsoft.Practices.EnterpriseLibrary.ExceptionHandling.WCF"
                exceptionMessage="Service error . Please contact your administrator ."
                faultContractType="UserManagerService.Fault.UserManagerServiceFault, UserManagerService, Version=1.0.0.0, Culture=neutral, PublicKeyToken=null"
                name="Fault Contract Exception Handler">
                <mappings>
                  <add source="{Guid}" name="FaultID" />
                  <add source="{Message}" name="FaultMessage" />
                  <add source="{Code}" name="Code" />
                </mappings>
              </add>
            </exceptionHandlers>
          </add>
        </exceptionTypes>
      </add>
    </exceptionPolicies>
  </exceptionHandling>
  <loggingConfiguration name="Logging Application Block" tracingEnabled="true" defaultCategory="Info" logWarningsWhenNoCategoriesMatch="true">
    <listeners>
      <add  header="----------------------------------------"
        footer="----------------------------------------" fileName=".\log\UserManagerService.log" rollSizeKB="1024" timeStampPattern="yyyy-MM-dd" rollFileExistsBehavior="Increment" rollInterval="Day" formatter="Text Formatter"  listenerDataType="Microsoft.Practices.EnterpriseLibrary.Logging.Configuration.RollingFlatFileTraceListenerData, Microsoft.Practices.EnterpriseLibrary.Logging, Version=5.0.414.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" traceOutputOptions="Timestamp" type="Microsoft.Practices.EnterpriseLibrary.Logging.TraceListeners.RollingFlatFileTraceListener, Microsoft.Practices.EnterpriseLibrary.Logging, Version=5.0.414.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" name="Rolling Flat File Trace Listener" />
      <add  header="----------------------------------------"
        footer="----------------------------------------" fileName=".\log\UserManagerService.log" rollSizeKB="1024" timeStampPattern="yyyy-MM-dd" rollFileExistsBehavior="Increment" rollInterval="Day" formatter="Text Formatter"  listenerDataType="Microsoft.Practices.EnterpriseLibrary.Logging.Configuration.RollingFlatFileTraceListenerData, Microsoft.Practices.EnterpriseLibrary.Logging, Version=5.0.414.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" traceOutputOptions="Timestamp" type="Microsoft.Practices.EnterpriseLibrary.Logging.TraceListeners.RollingFlatFileTraceListener, Microsoft.Practices.EnterpriseLibrary.Logging, Version=5.0.414.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" name="Log Errors Rolling Flat File Trace Listener" />
      <add  header="----------------------------------------"
        footer="----------------------------------------" fileName=".\log\UserManagerService_Error.log" rollSizeKB="1024" timeStampPattern="yyyy-MM-dd" rollFileExistsBehavior="Increment" rollInterval="Day" formatter="Text Formatter"  listenerDataType="Microsoft.Practices.EnterpriseLibrary.Logging.Configuration.RollingFlatFileTraceListenerData, Microsoft.Practices.EnterpriseLibrary.Logging, Version=5.0.414.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" traceOutputOptions="Timestamp" type="Microsoft.Practices.EnterpriseLibrary.Logging.TraceListeners.RollingFlatFileTraceListener, Microsoft.Practices.EnterpriseLibrary.Logging, Version=5.0.414.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" name="Error Handler" />
      <add  header="----------------------------------------"
        footer="----------------------------------------" fileName=".\log\UserManagerService_Debug.log" rollSizeKB="1024" timeStampPattern="yyyy-MM-dd" rollFileExistsBehavior="Increment" rollInterval="Day" formatter="Text Formatter"  listenerDataType="Microsoft.Practices.EnterpriseLibrary.Logging.Configuration.RollingFlatFileTraceListenerData, Microsoft.Practices.EnterpriseLibrary.Logging, Version=5.0.414.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" traceOutputOptions="Timestamp" type="Microsoft.Practices.EnterpriseLibrary.Logging.TraceListeners.RollingFlatFileTraceListener, Microsoft.Practices.EnterpriseLibrary.Logging, Version=5.0.414.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" name="Debug Handler" />
      <add  header="----------------------------------------"
        footer="----------------------------------------" fileName=".\log\UserManagerService.log" rollSizeKB="1024" timeStampPattern="yyyy-MM-dd" rollFileExistsBehavior="Increment" rollInterval="Day" formatter="Text Formatter"  listenerDataType="Microsoft.Practices.EnterpriseLibrary.Logging.Configuration.RollingFlatFileTraceListenerData, Microsoft.Practices.EnterpriseLibrary.Logging, Version=5.0.414.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" traceOutputOptions="Timestamp" type="Microsoft.Practices.EnterpriseLibrary.Logging.TraceListeners.RollingFlatFileTraceListener, Microsoft.Practices.EnterpriseLibrary.Logging, Version=5.0.414.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" name="WebServices category Rolling Flat File Trace Listener" />
    </listeners>
    <formatters>
      <add  template="Machine: {machine},{newline}Timestamp: {keyvalue(Time)},{newline}Category: {category},{newline}Severity: {severity},{newline}Message: {message},{newline}Exception: {keyvalue(Exception)}...." type="Microsoft.Practices.EnterpriseLibrary.Logging.Formatters.TextFormatter, Microsoft.Practices.EnterpriseLibrary.Logging, Version=5.0.414.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35"
       name="Text Formatter" >
      </add>
    </formatters>



    <logFilters>
      <add enabled="true" type="Microsoft.Practices.EnterpriseLibrary.Logging.Filters.LogEnabledFilter, Microsoft.Practices.EnterpriseLibrary.Logging, Version=5.0.414.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" name="LogEnabled Filter" />
    </logFilters>
    <categorySources>
      <!-- Posible "SwitchValue" values are 
            All,
            Off,
            Critical,
            Error,
            Warning,
            Information,
            Verbose (corresponds to Logger.Debug methods)
      -->
      <!-- General category..If no category is specified all logs go inside here-->
      <add switchValue="Information" name="Info">
        <listeners>
          <add name="Rolling Flat File Trace Listener" />
        </listeners>
      </add>
      <!-- Configure for UI category Source-->
      <add switchValue="Error" name="Error">
        <listeners>
          <add name="Error Handler" />
        </listeners>
      </add>
      <add switchValue="Verbose" name="Debug">
        <listeners>
          <add name="Debug Handler" />
        </listeners>
      </add>
      <!-- Configure for Web Services category Source
      <add switchValue="All" name="WebServices">
        <listeners>
          <add name="WebServices category Rolling Flat File Trace Listener" />
        </listeners>
      </add>-->
    </categorySources>
    <specialSources>
      <!-- All events.. Includes unspecified categories..In this case any category other than "General" will take the value here
            Note: The SwitchValue here takes precedence over the "switchValues" in the category Sources. So if you had Warning here, and 
            "Information" in one of the SwitchVaues before(for example: "Repoting" category Source, then 
            "Information" source for Reporting Category will not be logged!-->
      <allEvents switchValue="All" name="All Events">
        <listeners>
          <add name="Rolling Flat File Trace Listener" />
        </listeners>
      </allEvents>
      <!-- Unprocessed categories..We dont have that issue..by defaut everything goes to General-->
      <notProcessed switchValue="All" name="Unprocessed Category">
        <listeners>
          <add name="Rolling Flat File Trace Listener" />
        </listeners>
      </notProcessed>
      <!-- Errors encountered in the Logger. These will be logged go to a different file. THis ensures that if there is a probem with the main logfile used for logging,
           we can find out by lokking at this file-->
      <errors switchValue="All" name="Logging Errors &amp; Warnings">
        <listeners>
          <add name="Log Errors Rolling Flat File Trace Listener" />
        </listeners>
      </errors>
    </specialSources>
  </loggingConfiguration>

  <system.web>
    <compilation debug="true">
      <assemblies>
        <add assembly="System.Core, Version=3.5.0.0, Culture=neutral, PublicKeyToken=B77A5C561934E089" />
        <add assembly="System.Web.Extensions, Version=3.5.0.0, Culture=neutral, PublicKeyToken=31BF3856AD364E35" />
      </assemblies>
    </compilation>

  </system.web>
  <system.serviceModel>
    <services>   

      <service name="UserManagerService.Service.UserManagerService"
             behaviorConfiguration="UserManagerDebugServiceBehavior">

        <endpoint name="UserManagerDebugService"
                  binding="basicHttpBinding"
                  bindingConfiguration="UserManagerDebugServiceBinding"
                  contract="UserManagerService.Service.IUserManagerService" />

        <endpoint contract="IMetadataExchange" binding="mexHttpBinding" address="mex" />
      </service>
      
    </services>

    <bindings>

      <basicHttpBinding>
        <binding name="MyBind">
          <security mode="TransportWithMessageCredential">
            <message clientCredentialType="UserName"/>
          </security>
        </binding>

        <binding name="UserManagerDebugServiceBinding">
          <security mode="None">
            <message clientCredentialType="UserName"/>
          </security>
        </binding>     
        
      </basicHttpBinding>
    </bindings>

    <behaviors>
      <serviceBehaviors>
        <behavior name="BasicBehavior">
          <serviceMetadata httpGetEnabled="false" httpsGetEnabled="true" />
          <serviceDebug includeExceptionDetailInFaults="true" />
          <serviceAuthorization principalPermissionMode="Custom">
            <authorizationPolicies>
              <add policyType="UserManagerService.CustomAuthorization.CustomAuthorizationPolicy, UserManagerService" />
            </authorizationPolicies>
          </serviceAuthorization>
          <serviceCredentials>
            <serviceCertificate findValue="MyLocalCert" storeLocation="LocalMachine"
              storeName="My" x509FindType="FindBySubjectName" />
            <userNameAuthentication userNamePasswordValidationMode="Custom"
              customUserNamePasswordValidatorType="CustomValidator, UserManagerService" />
          </serviceCredentials>
        </behavior>
        
        <behavior name="UserManagerDebugServiceBehavior">
          <serviceMetadata httpGetEnabled="true" />
          <serviceDebug includeExceptionDetailInFaults="true" />
         <dataContractSerializer maxItemsInObjectGraph="6553600" />
        </behavior>
      </serviceBehaviors>
    </behaviors>
    
    <serviceHostingEnvironment multipleSiteBindingsEnabled="false" />

  </system.serviceModel>
  <system.webServer>
    <modules runAllManagedModulesForAllRequests="true" />
    <directoryBrowse enabled="true" />
  </system.webServer>

  <appSettings>
    <add key="Evolve.TemplateConfiguration" value="Mailing/templates.config" />
  </appSettings>

</configuration>
