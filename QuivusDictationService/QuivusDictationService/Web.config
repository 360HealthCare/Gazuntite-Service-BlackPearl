<?xml version="1.0"?>
<configuration>

  <system.web>
    <compilation debug="true" targetFramework="4.0" />
  </system.web>
  <system.serviceModel>
    <services>
      <service name="QuivusDictationService.QuivusDictationService"
            behaviorConfiguration="DictationServiceBehavior">

        <endpoint name="QuivusManagerService"
                  binding="webHttpBinding"
                  bindingConfiguration="webBinding"
                  behaviorConfiguration="webEndpoint"
                  contract="QuivusDictationService.IQuivusDictationService" />

        <endpoint contract="IMetadataExchange" binding="mexHttpBinding" address="mex" />
      </service>
      
    </services>
    <bindings>
      <webHttpBinding>
        <binding transferMode="Streamed"
                 maxBufferSize="2147483647"
                 maxReceivedMessageSize="2147483647"
                 openTimeout="00:25:00"
                 closeTimeout="00:25:00"
                 sendTimeout="00:25:00"
                 receiveTimeout="00:25:00"
                 name="webBinding">
          <!--<security mode="Transport"></security>-->
        </binding>
      </webHttpBinding>
      
    </bindings>
    <behaviors>
      <serviceBehaviors>
        <behavior name="DictationServiceBehavior">
          <serviceMetadata httpGetEnabled="true" />
          <serviceDebug includeExceptionDetailInFaults="true" />
        </behavior>
      </serviceBehaviors>
      
      <endpointBehaviors>
        <behavior name="webEndpoint">
          <webHttp />
        </behavior>
      </endpointBehaviors>
    </behaviors>
    
    <serviceHostingEnvironment multipleSiteBindingsEnabled="true" />
  </system.serviceModel>
 <system.webServer>
    <modules runAllManagedModulesForAllRequests="true"/>
  </system.webServer>
  
</configuration>
