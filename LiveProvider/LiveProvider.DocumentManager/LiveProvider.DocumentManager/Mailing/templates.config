<?xml version="1.0" encoding="utf-8" ?>


<!--

  IMPORTANT: Don't forget to add this key in the AppSettings section
  of your configuration file (App.config / web.config) and make
  sure the config file and templates are present.
  
	<appSettings>
    <add key="Evolve.TemplateConfiguration" value="templates.config" />
  </appSettings>

-->


<!--
  Root element with an optional base directory. Any relative
  links for templates will be calculated relative to this folder.
-->
<TemplateConfiguration>

  <!--
    Optional base folder for templates with relative path settings.
  -->
  <BaseDirectory>Mailing</BaseDirectory>

  <!--
    Add this value to explicitely set this server (recommended in most times).
  -->
  <!--<SmtpServer>smtp.gmail.com</SmtpServer>-->
  <SmtpServer>host.quivus.com</SmtpServer>
  
  <Groups>
    <TemplateGroup TemplateGroupId="SimpleMailByProvider" Sender="support@quivus.com" MailFormat="Text">
      <Templates>
        <!--   
            You can set the language attribute of the default template
            for your own information but it's not needed (and ignored)
            by the framework.
          -->
        <Template Locale="en" IsDefault="true">
          <Subject>TEST</Subject>
          <!-- File paths can be absolute or relative. -->
          <File>templates/SimpleMailByProvider.txt</File>
        </Template>
      </Templates>
    </TemplateGroup>

    <TemplateGroup TemplateGroupId="PatientRegistration" Sender="support@quivus.com" MailFormat="Text">
      <Templates>
        <!--   
            You can set the language attribute of the default template
            for your own information but it's not needed (and ignored)
            by the framework.
          -->
        <Template Locale="en" IsDefault="true">
          <Subject>Quivus Registration</Subject>
          <!-- File paths can be absolute or relative. -->
          <File>templates/PatientRegistration.txt</File>
        </Template>
      </Templates>
    </TemplateGroup>

    <TemplateGroup TemplateGroupId="DocumentUpload" Sender="support@quivus.com" MailFormat="Text">
      <Templates>
        <!--   
            You can set the language attribute of the default template
            for your own information but it's not needed (and ignored)
            by the framework.
          -->
        <Template Locale="en" IsDefault="true">
          <Subject> Quivus :: Document Uploading Status Confirmation Message</Subject>
          <!-- File paths can be absolute or relative. -->
          <File>templates/DocumentUpload.txt</File>
        </Template>
      </Templates>
    </TemplateGroup>

    <TemplateGroup TemplateGroupId="BulkUploadFailure" Sender="support@quivus.com" MailFormat="Text">
      <Templates>
        <!--   
            You can set the language attribute of the default template
            for your own information but it's not needed (and ignored)
            by the framework.
          -->
        <Template Locale="en" IsDefault="true">
          <Subject>Quivus :: Document Uploading Error Message</Subject>
          <!-- File paths can be absolute or relative. -->
          <File>templates/BulkUploadFailure.txt</File>
        </Template>
      </Templates>
    </TemplateGroup>
    
  </Groups>
</TemplateConfiguration>